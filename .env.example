# Standalone Supabase project configuration
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-supabase-anon-or-publishable-key>"

# Optional: Firebase Web Push configuration (only needed for browser push notifications;
# the native Android app schedules booster notifications locally via WorkManager)
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_VAPID_KEY=""
